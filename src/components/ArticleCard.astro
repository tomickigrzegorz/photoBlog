---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  slug: string;
  title: string;
  thumbnail: string;
  thumbnailAlt: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { slug, title, thumbnail, thumbnailAlt, loading = 'lazy', fetchpriority } = Astro.props;
const webpThumbnail = thumbnail.replace(/\.(jpe?g|png)$/i, '.webp');
const hasWebp =
  webpThumbnail !== thumbnail &&
  fs.existsSync(path.join(process.cwd(), 'public/images', webpThumbnail));
---

<div class="gallery__items">
  <a href={`/${slug}.html`}>
    <figure>
      <picture>
        {hasWebp && <source type="image/webp" srcset={`/images/${webpThumbnail}`} />}
        <img
          src={`/images/${thumbnail}`}
          alt={thumbnailAlt}
          loading={loading}
          fetchpriority={fetchpriority}
          width="576"
          height="384"
        />
      </picture>
      <figcaption>{title}</figcaption>
    </figure>
  </a>
</div>
